// Template shader for generating pixel shader source
#version 330 core

#define $lighting_model

uniform vec3 light_dir = vec3(0.3, 0.3, -0.4);
uniform vec3 light_color = vec3(1.0, 1.0, 1.0);
uniform float light_intensity = 1.0;

uniform vec3 view_dir = vec3(0.0, 0.0, -1.0);

// Pixel shader inputs from vertex stage
in vec3 pix_position;
in vec3 pix_color;
in vec3 pix_normal;

// Structure containing graph ouputs
struct GraphOutput {
	vec3 albedo;	// Surface color
	vec3 alpha;		// Opacity

#ifdef PHONG_LIGHTING_MODEL
	vec3 normal;	// Vertex normal
	vec3 spec;		// Specular color & intensity
#endif
};

// Main function for generating values from shader graph nodes
GraphOutput interpretGraph() {
$graph_src

	GraphOutput output;
	output.albedo = vec3(albedo);
	output.alpha = vec3(alpha);

#ifdef PHONG_LIGHTING_MODEL
	output.normal = vec3(normal);
	output.spec = vec3(spec);
#endif

	return output;
}

#ifdef PHONG_LIGHTING_MODEL
vec4 PhongMain() {

	GraphOutput values = interpretGraph();

	// Blinn-Phong coefficients.
	vec3 normal = normalize(values.normal);
	vec3 half_dir = normalize(light_dir + view_dir);
	float NdotL = dot(normal, light_dir);
	float lambertian = max(NdotL, 0.0);
	float specAngle = max(dot(half_dir, normal), 0.0);
	float spec = pow(specAngle, 32.0);

	// Blinn-Phong light components.
	vec3 direct = values.albedo * lambertian * light_intensity * light_color;
	vec3 specular = values.spec * spec * light_color; 
	vec3 composite = direct + specular;

	return vec4(composite, values.alpha);
}
#endif


// Pixel shader outputs
out vec4 frag_color;

// Pixel shader entry point
void main() {

#ifdef PHONG_LIGHTING_MODEL
	/// Blinn-Phong lighting model.
	frag_color = PhongMain();
	return;

#else
	/// Fallback lighting model.
	GraphOutput values = interpretGraph();
	vec3 col = pix_color * values.albedo;
	frag_color = vec4(col, 1.0);
	return;

#endif
}
